# WhatsApp Business phone number used server-side by /api/pedir (digits with country code, e.g. 5213300000000)
WA_NUMBER=

# Local testing only: set to "true" on localhost to connect to local Firebase Auth & Firestore emulators
VITE_USE_FIREBASE_EMULATOR=false

# Optional public VAPID key (Base64 URL-safe) for Web Push server-to-worker push subscriptions
VITE_VAPID_PUBLIC_KEY=

