<script>
(() => {
  const $ = (s, r = document) => r.querySelector(s);
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const bar = $('.bar'), io = 'IntersectionObserver' in window;
  if (io) new IntersectionObserver(([e]) => bar.classList.toggle('stuck', !e.isIntersecting && e.boundingClientRect.top < 0)).observe($('#sentinel'));

  // Chip activo según la sección visible
  const chips = [...document.querySelectorAll('.chips a')];
  const map = new Map(chips.map((a) => [a.hash.slice(1), a]));
  if (io) {
    const spy = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      const a = map.get(e.target.id), box = a.parentElement;
      chips.forEach((c) => { c.classList.toggle('on', c === a); c === a ? c.setAttribute('aria-current', 'true') : c.removeAttribute('aria-current'); });
      box.scrollTo({ left: a.offsetLeft - (box.clientWidth - a.offsetWidth) / 2, behavior: reduce.matches ? 'auto' : 'smooth' });
    }), { rootMargin: '-20% 0px -70% 0px' });
    map.forEach((_, id) => { const t = document.getElementById(id); if (t) spy.observe(t); });
  }

  // Sheet: seguimiento 1:1, resorte críticamente amortiguado, velocidad y proyección
  const dlg = $('#sheet'), head = $('.sheet-head');
  let y = 0, vel = 0, raf = 0, opener = null, drag = null;
  const H = () => dlg.offsetHeight;
  const set = (v) => { y = v; dlg.style.transform = `translateY(${v}px)`; dlg.style.setProperty('--dim', Math.max(0, Math.min(1, 1 - v / H()))); };
  const rubber = (o, d) => (o * d * 0.55) / (d + 0.55 * o);
  const project = (v) => (v / 1000) * 0.99 / 0.01;
  function spring(to, v0, done) {
    cancelAnimationFrame(raf);
    if (reduce.matches) { set(to); if (done) done(); return; }
    const w = (2 * Math.PI) / 0.34, x0 = y - to, c2 = v0 + w * x0, t0 = performance.now();
    const step = (n) => {
      const t = (n - t0) / 1000, e = Math.exp(-w * t);
      set(to + (x0 + c2 * t) * e); vel = (c2 - w * (x0 + c2 * t)) * e;
      if (t < 1 && (Math.abs(y - to) > 0.4 || Math.abs(vel) > 8)) raf = requestAnimationFrame(step);
      else { set(to); vel = 0; if (done) done(); }
    };
    raf = requestAnimationFrame(step);
  }
  function open(b) {
    opener = b;
    $('#s-name').textContent = b.dataset.n;
    $('#s-price').textContent = b.dataset.p;
    $('#s-group').textContent = b.dataset.g;
    $('#s-sub').textContent = b.dataset.s || '';
    $('#s-cta').href = 'https://wa.me/523314456850?text=' + encodeURIComponent(`Hola, quiero pedir: ${b.dataset.n} (${b.dataset.p})`);
    dlg.showModal(); set(H()); spring(0, 0);
  }
  const close = () => spring(H(), Math.max(vel, 0), () => { dlg.close(); if (opener) opener.focus(); });
  document.addEventListener('click', (e) => { const b = e.target.closest('[data-n]'); if (b) open(b); });
  dlg.addEventListener('click', (e) => { if (e.target === dlg) close(); });
  dlg.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
  $('.ghost').addEventListener('click', close);
  head.addEventListener('pointerdown', (e) => { cancelAnimationFrame(raf); head.setPointerCapture(e.pointerId); drag = { start: e.clientY, base: y, s: [[e.timeStamp, e.clientY]] }; });
  head.addEventListener('pointermove', (e) => {
    if (!drag) return;
    drag.s.push([e.timeStamp, e.clientY]); if (drag.s.length > 6) drag.s.shift();
    const d = e.clientY - drag.start + drag.base; set(d < 0 ? -rubber(-d, 300) : d);
  });
  const end = () => {
    if (!drag) return;
    const a = drag.s[0], b = drag.s[drag.s.length - 1];
    vel = b[0] > a[0] ? ((b[1] - a[1]) / (b[0] - a[0])) * 1000 : 0; drag = null;
    if (y + project(vel) > H() * 0.5) close(); else spring(0, vel);
  };
  head.addEventListener('pointerup', end); head.addEventListener('pointercancel', end);
})();

</script>
