  <style>
:root{color-scheme:dark;--bg:#0a0a0b;--card:#161618;--card2:#1f1f22;--cream:#f0e6d3;--dim:rgba(240,230,211,.72);--gold:#c8a84b;--goldb:#e8d090;--golddim:rgba(200,168,75,.28);--line:rgba(240,230,211,.1);--edge:rgba(255,255,255,.14);--mat:rgba(22,22,24,.62);--wa:#25d366;--serif:Georgia,'Iowan Old Style','Palatino Linotype',serif;--sans:system-ui,-apple-system,'SF Pro Text','Segoe UI',Roboto,sans-serif;--top:env(safe-area-inset-top,0px);--bot:env(safe-area-inset-bottom,0px)}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:calc(110px + var(--top));-webkit-text-size-adjust:100%;-webkit-tap-highlight-color:transparent}
body{background:var(--bg) radial-gradient(circle at 20% 30%,rgba(200,168,75,.04) 1px,transparent 1px) 0 0/28px 28px;color:var(--cream);font:1rem/1.5 var(--sans);-webkit-font-smoothing:antialiased;padding-bottom:calc(110px + var(--bot))}
main,footer{width:min(100%,640px);margin-inline:auto;padding-inline:max(16px,env(safe-area-inset-left))}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer;touch-action:manipulation}
ul{list-style:none}
:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
.sprite{position:absolute;width:0;height:0;overflow:hidden}
.skip{position:absolute;left:-9999px}.skip:focus{left:12px;top:calc(12px + var(--top));z-index:100;background:var(--gold);color:var(--bg);padding:12px 16px;border-radius:12px;font-weight:700;text-decoration:none}
.hero{text-align:center;padding:calc(56px + var(--top)) 0 28px}
.logo{width:96px;height:auto;margin:0 auto 20px;display:block;filter:drop-shadow(0 0 24px rgba(240,230,211,.15))}
h1{font:700 clamp(2.5rem,12vw,3.5rem)/1.05 var(--serif);letter-spacing:-.02em;text-transform:uppercase}
.tag{color:var(--gold);font-size:.8125rem;letter-spacing:.14em;text-transform:uppercase;margin-top:10px}
.addr{color:var(--dim);font-size:.875rem;font-style:normal;margin-top:6px}
/* Material translúcido: el contenido pasa por debajo */
.bar{position:sticky;top:0;z-index:10;margin-inline:calc(max(16px,env(safe-area-inset-left)) * -1);padding:var(--top) max(16px,env(safe-area-inset-left)) 0;background:var(--mat);backdrop-filter:blur(20px) saturate(180%);-webkit-backdrop-filter:blur(20px) saturate(180%);border-top:1px solid var(--edge);transition:box-shadow .25s}
.bar.stuck{box-shadow:0 1px 0 var(--line),0 8px 24px rgba(0,0,0,.35)}
.bar-title{display:flex;align-items:center;gap:10px;max-height:0;opacity:0;overflow:hidden;font:700 1.0625rem var(--serif);letter-spacing:.04em;text-transform:uppercase;transition:max-height .3s cubic-bezier(.32,.72,0,1),opacity .2s}
.bar.stuck .bar-title{max-height:48px;opacity:1;padding-top:8px}
.bar-title svg{width:24px;height:auto}
.chips{position:relative;display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;padding:10px 0 12px}
.chips::-webkit-scrollbar{display:none}
.chips a{flex:none;display:flex;align-items:center;min-height:44px;padding:0 16px;border:1px solid var(--golddim);border-radius:22px;color:var(--dim);font-size:.8125rem;font-weight:600;letter-spacing:.02em;text-decoration:none;white-space:nowrap;user-select:none;-webkit-user-select:none;transition:transform .15s,background-color .2s,color .2s}
.chips a:active{transform:scale(.97)}
.chips a.on{background:var(--gold);border-color:var(--gold);color:var(--bg)}
h2.part{font:700 2rem/1.1 var(--serif);letter-spacing:-.02em;color:var(--gold);margin:56px 4px 0}
.sec h3{font:700 1.5rem/1.2 var(--serif);letter-spacing:-.01em;margin:36px 4px 6px;text-wrap:balance}
.cap{font-size:.75rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--dim);margin:18px 16px 8px}
.desc,.foot{font-size:.8125rem;color:var(--dim);margin:-2px 16px 8px}.foot{margin:8px 16px 0}
.list{background:var(--card);border-radius:20px;overflow:hidden;box-shadow:inset 0 1px 0 var(--edge)}
.list li+li{border-top:1px solid var(--line)}
.row{display:flex;justify-content:space-between;align-items:center;gap:16px;width:100%;min-height:56px;padding:12px 16px;text-align:left;transition:background-color .25s}
.row:active{background:var(--card2);transition:none}
.r-name{display:block;font-weight:500;overflow-wrap:anywhere}
.r-sub{display:block;font-size:.8125rem;color:var(--dim);margin-top:2px}
.r-price{flex:none;color:var(--goldb);font-weight:600;font-variant-numeric:tabular-nums}
.flav{display:flex;flex-wrap:wrap;gap:8px;padding:14px 16px}
.flav li{padding:6px 14px;border-radius:999px;background:rgba(200,168,75,.12);color:var(--gold);font-size:.875rem}
.cards{display:flex;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;margin-inline:-16px;padding:4px 16px 12px;scroll-padding-inline:16px;scrollbar-width:none}
.cards::-webkit-scrollbar{display:none}
.card{flex:0 0 min(72%,224px);scroll-snap-align:start;display:flex;flex-direction:column;gap:4px;text-align:left;padding:18px 16px;border:1px solid var(--golddim);border-radius:22px;background:linear-gradient(160deg,rgba(200,168,75,.1),var(--card) 65%);transition:transform .15s}
.card:active{transform:scale(.97)}
.c-ico{font-size:1.5rem;line-height:1}.c-name{font:600 1.0625rem/1.25 var(--serif);margin-top:6px}.c-price{color:var(--goldb);font-weight:700}.c-desc{font-size:.8125rem;color:var(--dim)}
/* Sheet: arrastre 1:1, resorte, velocidad */
.sheet{margin:auto auto 0;width:min(100%,640px);max-width:none;max-height:88dvh;border:0;border-radius:28px 28px 0 0;padding:0;color:var(--cream);background:var(--mat);backdrop-filter:blur(28px) saturate(180%);-webkit-backdrop-filter:blur(28px) saturate(180%);box-shadow:inset 0 1px 0 var(--edge);overflow:visible;will-change:transform}
.sheet::backdrop{background:rgb(0 0 0/calc(var(--dim,1)*.55))}
.sheet-head{touch-action:none;cursor:grab;padding:10px 0 6px}
.grab{width:36px;height:5px;border-radius:3px;background:var(--edge);margin:0 auto}
.sheet-body{padding:8px 24px calc(24px + var(--bot))}
#s-name{font:700 1.75rem/1.15 var(--serif);letter-spacing:-.01em}
#s-price{color:var(--goldb);font-size:1.375rem;font-weight:700;margin-top:4px}
#s-group,#s-sub{color:var(--dim);font-size:.875rem;margin-top:4px}
.cta{display:flex;align-items:center;justify-content:center;gap:8px;min-height:52px;margin-top:20px;border-radius:16px;background:var(--wa);color:var(--bg);font-weight:700;text-decoration:none;transition:transform .15s}
.cta:active{transform:scale(.97)}
.ghost{width:100%;min-height:48px;margin-top:8px;border-radius:16px;color:var(--dim);font-weight:600}
footer{padding-top:48px;text-align:center;color:var(--dim);font-size:.8125rem}
footer a{color:var(--gold);display:inline-flex;align-items:center;min-height:44px;padding:0 10px;text-decoration:none}
.fab{position:fixed;right:max(16px,env(safe-area-inset-right));bottom:calc(16px + var(--bot));z-index:40;display:flex;align-items:center;gap:8px;min-height:48px;padding:0 18px;border-radius:999px;background:var(--wa);color:var(--bg);font-weight:700;font-size:.875rem;text-decoration:none;box-shadow:0 8px 24px rgba(0,0,0,.45);transition:transform .15s}
.fab svg{width:20px;height:20px}.fab:active{transform:scale(.97)}
@media (hover:hover) and (pointer:fine){.row:hover{background:var(--card2)}.chips a:hover{color:var(--cream);border-color:var(--gold)}.card:hover{transform:translateY(-3px)}}
@media (prefers-reduced-transparency:reduce){.bar,.sheet{background:var(--card);backdrop-filter:none;-webkit-backdrop-filter:none}}
@media (prefers-contrast:more){.list,.card,.sheet{border:1px solid var(--cream)}.r-sub,.desc,.foot,.cap{color:var(--cream)}}
@media (prefers-reduced-motion:reduce){*,*::before,*::after{transition-duration:.01ms!important;scroll-behavior:auto!important}}
@media print{.bar,.fab,.sheet,.skip{display:none!important}body{background:#fff;color:#000}}
